FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.lock /opt/requirements.lock
RUN python -m pip install -r /opt/requirements.lock \
    && python -m pip check \
    && python -m pip freeze > /opt/runtime-requirements.lock

RUN groupadd --gid 10001 lab03 \
    && useradd --uid 10001 --gid 10001 --no-create-home lab03

USER 10001:10001
CMD ["python", "-c", "print('LAB03 runtime ready')"]